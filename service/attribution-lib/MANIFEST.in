# Include the main package
graft src

# Include test configuration
include tests/conftest.py

# Include documentation and metadata
include README.md
include LICENSE

# Exclude unwanted files
global-exclude *.pyc
global-exclude __pycache__
recursive-exclude * *.py[co]
