# Exclude local environments, caches, build output, and secret files after all
# broad source re-includes above.
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.cache
**/build
**/dist
**/*.egg-info
**/*.py[co]
**/.env
**/.env.*
